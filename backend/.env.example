# ── Database ──
DATABASE_URL="postgresql://user:password@localhost:5432/gitsense"

# ── Auth ──
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"
PORT=5000

# ── GitHub OAuth ──
# Create OAuth app: https://github.com/settings/developers
# Authorization callback URL: http://localhost:5000/api/github/callback
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"
GITHUB_CALLBACK_URL="http://localhost:5000/api/github/callback"
GITHUB_TOKEN="optional_github_token_for_api_fallback"

# ── Server URLs ──
BACKEND_URL="http://localhost:5000"
FRONTEND_URL="http://localhost:5000"

# ── AI Provider (Groq / TruGen) ──
GROQ_API_KEY="your_groq_api_key"
TRUGEN_API_KEY="your_trugen_api_key"
TURDEN_MODEL="huma-2"
TURGEN_BASE_URL="https://api.trugen.ai/v1"

